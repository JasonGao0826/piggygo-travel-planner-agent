# 复制这个文件为 .env，再填入真实的值。.env 不会进 git。
# 模型提供方，目前只支持 openai
LLM_PROVIDER=openai
# OpenAI 的 API key（在 platform.openai.com → API keys 创建）
OPENAI_API_KEY=
# 主力模型（规划、对话），填接口里的型号 id，不是显示名称
OPENAI_MODEL=gpt-6.1-sol
# 轻量模型（意图判断、信息抽取等）
OPENAI_MODEL_LIGHT=gpt-6-luna
# 推理强度：low / medium / high / xhigh / max
OPENAI_REASONING_EFFORT=medium
# 接口地址。直连 OpenAI 就用下面这个默认值；用代理或中转服务时改成对方给的地址
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- 外部数据（都可以不填） ----------
# 机票（Kiwi.com）、汇率（Frankfurter）、网页搜索（Exa）、路况（NZTA）、天气预警（MetService）不需要 key。
# Open-Meteo 天气预报免费版只能非商业使用；正式上线后在 open-meteo.com 买 API 套餐，把 key 填在这里
OPEN_METEO_API_KEY=
