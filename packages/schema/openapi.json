              "type": "object"
            },
            "type": "array",
            "title": "Tool Calls"
          },
          "usage": {
            "additionalProperties": true,
            "type": "object",
            "title": "Usage"
          }
        },
        "type": "object",
        "required": [
          "reply",
          "patches",
